rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/tasks/{taskId} {
   function owner() { return request.auth != null && request.auth.uid == userId; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasOnly(['title','notes','quadrant','due','done','createdAt','updatedAt','completedAt','deleted'])
      && d.title is string && d.title.size() > 0 && d.title.size() <= 240
      && d.notes is string && d.notes.size() <= 5000
      && d.quadrant in ['do','plan','delegate','later']
      && d.due is string && d.due.size() <= 10
      && d.done is bool && d.deleted is bool
      && d.createdAt is number && d.updatedAt is number && d.completedAt is number;
   }
   allow read: if owner();
   allow create, update: if owner() && valid();
   allow delete: if owner();
  }
 }
}
